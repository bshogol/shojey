#!/bin/bash

# shojey — a tiny music player for Omarchy.
#
# Playback is a single background mpv with an IPC socket. The system-wide
# mpv-mpris script exposes it over MPRIS, so Omarchy's media widget, media
# keys and OSD pick it up without any extra wiring.
#
# Sources: SomaFM and Radio Paradise channels, Radio Browser stations,
# Audius and ccMixter tracks.
#
# State the bar popup reads:
#   $XDG_RUNTIME_DIR/shojey/current.json   what was last started (gone when stopped)
#   $XDG_RUNTIME_DIR/shojey/error.json     why playback ended on its own, if it failed
#   $XDG_RUNTIME_DIR/shojey/sleep.json     the sleep timer, while one is set
#   $XDG_STATE_HOME/shojey/recent.json     last 30 things played
#   $XDG_STATE_HOME/shojey/favorites.json  hearted entries
#   $XDG_STATE_HOME/shojey/history.json    songs heard on live stations
# Each entry is {source, name, url, live, art}.

set -euo pipefail

APP_NAME="shojey"
USER_AGENT="shojey/0.2"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}/shojey"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/shojey"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/shojey"
SOCKET="$RUNTIME_DIR/mpv.sock"
PLAYLIST="$RUNTIME_DIR/queue.m3u"
QUEUE="$RUNTIME_DIR/queue.json"
CURRENT="$RUNTIME_DIR/current.json"
ERROR="$RUNTIME_DIR/error.json"
SESSION="$RUNTIME_DIR/session"
SLEEP="$RUNTIME_DIR/sleep.json"
RECENT="$STATE_DIR/recent.json"
FAVORITES="$STATE_DIR/favorites.json"
HISTORY="$STATE_DIR/history.json"
VOLUME="$STATE_DIR/volume"
RECENT_MAX=30
HISTORY_MAX=200
CACHE_TTL="${SHOJEY_CACHE_TTL:-600}"
AUDIUS_API="https://api.audius.co/v1"
RADIO_API="https://all.api.radio-browser.info/json"
SOMA_API="https://somafm.com/channels.json"
PARADISE_API="https://api.radioparadise.com/api"
PARADISE_STREAMS="https://stream.radioparadise.com"
CCMIXTER_API="https://ccmixter.org/api/query"

ICON_MUSIC=$'\U000f075a'
ICON_RADIO=$'\U000f0439'
ICON_SEARCH=$'\U000f0349'
ICON_TRENDING=$'\U000f0535'
ICON_STOP=$'\U000f04db'
ICON_PAUSE=$'\U000f03e4'
ICON_HEART=$'\U000f02d1'

mkdir -p "$RUNTIME_DIR" "$STATE_DIR" "$CACHE_DIR"
[[ -f $RECENT ]] || echo '[]' >"$RECENT"
[[ -f $FAVORITES ]] || echo '[]' >"$FAVORITES"
[[ -f $HISTORY ]] || echo '[]' >"$HISTORY"

fail() {
  echo "shojey: $*" >&2
  notify "$*"
  exit 1
}

notify() {
  command -v omarchy-notification-send >/dev/null || return 0
  omarchy-notification-send "shojey" "$*" || true
}

fetch() {
  curl -fsSL --max-time 15 -A "$USER_AGENT" "$@"
}

uri() {
  jq -rn --arg v "$1" '$v | @uri'
}

# --- state ----------------------------------------------------------------

# entry <source> <name> <url> <live:true|false> [art]
entry() {
  jq -cn --arg source "$1" --arg name "$2" --arg url "$3" --argjson live "$4" --arg art "${5:-}" \
    '{source:$source, name:$name, url:$url, live:$live, art:$art}'
}

# Write through a temp file so the popup's file watcher never reads half a file.
write_json() {
  local file="$1" tmp
  tmp=$(mktemp "$file.XXXXXX")
  cat >"$tmp"
  mv "$tmp" "$file"
}

remember() {
  local e="$1"
  write_json "$CURRENT" <<<"$e"
  jq -c --argjson e "$e" --argjson max "$RECENT_MAX" \
    '[$e] + map(select(.url != $e.url)) | .[:$max]' "$RECENT" | write_json "$RECENT"
}

# Look a url up in everything shojey knows about, newest first.
lookup() {
  local url="$1" files=()
  local f
  for f in "$CURRENT" "$QUEUE" "$FAVORITES" "$RECENT"; do
    [[ -s $f ]] && files+=("$f")
  done
  (( ${#files[@]} )) || return 1
  jq -cs --arg url "$url" '
    map(if type == "array" then .[] else . end) | map(select(.url == $url)) | first // empty
  ' "${files[@]}"
}

toggle_favorite() {
  local url="${1:-}" name="${2:-}" e
  if [[ -z $url ]]; then
    [[ -s $CURRENT ]] || fail "nothing playing to favorite"
    url=$(jq -r '.url' "$CURRENT")
  fi
  if jq -e --arg url "$url" 'any(.[]; .url == $url)' "$FAVORITES" >/dev/null; then
    jq -c --arg url "$url" 'map(select(.url != $url))' "$FAVORITES" | write_json "$FAVORITES"
    return
  fi
  e=$(lookup "$url") || true
  [[ -n $e ]] || e=$(entry "Stream" "${name:-$url}" "$url" false)
  # A queued Audius track keeps its own title, not the one it was queued under.
  [[ -n $name ]] && e=$(jq -c --arg name "$name" '.name = $name' <<<"$e")
  jq -c --argjson e "$e" '[$e] + .' "$FAVORITES" | write_json "$FAVORITES"
}

# --- playback -------------------------------------------------------------

running() {
  [[ -S $SOCKET ]] && ipc '{"command":["get_property","pid"]}' >/dev/null 2>&1
}

ipc() {
  socat - "UNIX-CONNECT:$SOCKET" <<<"$1"
}

# Removing the session first tells the watcher this stop was on purpose.
stop() {
  rm -f "$SESSION"
  if running; then
    ipc '{"command":["quit"]}' >/dev/null || true
  fi
  rm -f "$SOCKET" "$CURRENT" "$ERROR" "$QUEUE"
}

# launch <m3u-file> [start-index] [mpv flags...]
# Starts mpv in the background under a watcher. An m3u with #EXTINF titles
# gives mpv (and so MPRIS) a readable title for every entry, and lets
# next/previous walk the rest of the result list. Callers stop the old
# player and write current.json first.
launch() {
  local file="$1" start="${2:-0}" session code pid
  shift 2
  session="$$.$RANDOM.$(date +%s%N)"
  echo "$session" >"$SESSION"
  (
    # shellcheck disable=SC2086 # SHOJEY_MPV_ARGS is a list of extra flags.
    mpv --no-video --idle=no --no-terminal --volume="$(saved_volume)" ${SHOJEY_MPV_ARGS:-} \
      --input-ipc-server="$SOCKET" \
      --stream-lavf-o=reconnect=1,reconnect_streamed=1,reconnect_on_network_error=1,reconnect_delay_max=10 \
      --playlist-start="$start" "$@" \
      --playlist="$file" &
    pid=$!
    watch_titles &
    wait "$pid" && code=0 || code=$?
    playback_ended "$session" "$code"
  ) >/dev/null 2>&1 &
  disown
}

# Runs when mpv exits. A newer play or a stop has replaced the session, so
# only an exit nobody asked for gets here: a failed stream (mpv exits 2), a
# live stream that ended, or a queue that played to the end.
playback_ended() {
  local session="$1" code="$2" e name live message
  [[ -f $SESSION && $(<"$SESSION") == "$session" ]] || return 0
  rm -f "$SESSION" "$SOCKET"
  e=$(cat "$CURRENT" 2>/dev/null) || true
  rm -f "$CURRENT" "$QUEUE"
  [[ -n $e ]] || return 0
  live=$(jq -r '.live // false' <<<"$e")
  if (( code != 0 )); then
    message="Couldn't play it; the stream may be offline"
  elif [[ $live == true ]]; then
    message="The stream stopped"
  else
    return 0
  fi
  name=$(jq -r '.name' <<<"$e")
  jq -cn --argjson entry "$e" --arg message "$message" '{entry:$entry, message:$message}' | write_json "$ERROR"
  notify "$name: $message"
}

# Logs each song a live station announces, so "what was that?" has an answer
# later. Follows mpv's title over its IPC socket and ends when mpv does.
watch_titles() {
  local e station title
  e=$(cat "$CURRENT" 2>/dev/null) || return 0
  [[ $(jq -r '.live // false' <<<"$e") == true ]] || return 0
  station=$(jq -r '.name' <<<"$e")
  for _ in {1..50}; do
    [[ -S $SOCKET ]] && break
    sleep 0.1
  done
  # ignoreeof keeps socat reading after the one command has been sent.
  socat STDIO,ignoreeof "UNIX-CONNECT:$SOCKET" <<<'{"command":["observe_property",1,"media-title"]}' 2>/dev/null \
    | jq --unbuffered -r 'select(.event == "property-change" and .name == "media-title") | .data // empty' \
    | while IFS= read -r title; do
      # Until the stream sends a song, the title is the station's own name.
      [[ -n $title && $title != "$station" && $title != http* ]] || continue
      log_song "$e" "$title"
    done
}

log_song() {
  jq -c --argjson e "$1" --arg title "$2" --arg when "$(date '+%b %-d %H:%M')" --argjson max "$HISTORY_MAX" '
    if (.[0].name // "") == $title then . else
      [{source: $e.source, name: $title, url: ("history:" + (now * 1000 | floor | tostring)),
        live: false, art: ($e.art // ""), detail: ($e.name + " · " + $when)}] + . | .[:$max]
    end' "$HISTORY" | write_json "$HISTORY"
}

# ccMixter only serves its mp3s to requests that come from its own site.
source_flags() {
  if jq -e 'if type == "array" then any(.[]; .source == "ccMixter") else .source == "ccMixter" end' <<<"$1" >/dev/null; then
    echo "--referrer=https://ccmixter.org/"
  fi
}

# play_entry <entry-json>
# Accepts any entry from a `list` result, a favorite or a recent play.
play_entry() {
  local e="$1" name url uuid
  name=$(jq -r '.name' <<<"$e")
  url=$(jq -r '.url' <<<"$e")
  uuid=$(jq -r '.uuid // empty' <<<"$e")
  # mpv expands a .pls into a nested playlist and drops our title, so play
  # the first stream it lists directly.
  if [[ $url == *.pls* ]]; then
    local resolved
    resolved=$(fetch "$url" | sed -n 's/^File1=//p' | tr -d '\r') || true
    [[ -n $resolved ]] && url=$resolved
  fi
  # Count the click, as Radio Browser asks clients to; best effort.
  [[ -n $uuid ]] && { fetch "$RADIO_API/url/$uuid" >/dev/null 2>&1 & }
  e=$(jq -c --arg url "$url" '.url = $url | del(.uuid, .detail, .title)' <<<"$e")
  printf '#EXTM3U\n#EXTINF:-1,%s\n%s\n' "$name" "$url" >"$PLAYLIST"
  stop
  rm -f "$QUEUE"
  remember "$e"
  # shellcheck disable=SC2046 # zero or one flag
  launch "$PLAYLIST" 0 $(source_flags "$e")
}

# play_list <index> <entries-json>
# Queues every entry so next / previous keep going through the list.
play_list() {
  local index="$1"
  stop
  jq -c 'map(del(.uuid, .detail, .title))' <<<"$2" | write_json "$QUEUE"
  jq -r '"#EXTM3U", (.[] | "#EXTINF:-1,\(.name)", .url)' "$QUEUE" >"$PLAYLIST"
  remember "$(jq -c ".[$index]" "$QUEUE")"
  # shellcheck disable=SC2046 # zero or one flag
  launch "$PLAYLIST" "$index" $(source_flags "$2")
}

play_saved() {
  local url="$1" e
  e=$(lookup "$url") || true
  [[ -n $e ]] || e=$(entry "Stream" "$url" "$url" false)
  play_entry "$e"
}

# Pause / resume; with nothing running, play the last thing again.
toggle() {
  if running; then
    ipc '{"command":["cycle","pause"]}' >/dev/null
  else
    resume
  fi
}

resume() {
  local url
  url=$(jq -r '.[0].url // empty' "$RECENT")
  [[ -n $url ]] || return 0
  play_saved "$url"
}

forget() {
  [[ -n ${1:-} ]] || fail "forget needs a url"
  local file
  for file in "$RECENT" "$HISTORY"; do
    jq -c --arg url "$1" 'map(select(.url != $url))' "$file" | write_json "$file"
  done
}

copy_text() {
  [[ -n ${1:-} ]] || fail "copy needs some text"
  wl-copy -- "$1" || fail "could not copy to the clipboard"
  notify "Copied: $1"
}

saved_volume() {
  local level
  level=$(cat "$VOLUME" 2>/dev/null) || true
  [[ $level =~ ^[0-9]+$ ]] && echo "$level" || echo 100
}

# volume [N|+N|-N] — mpv's own volume, 0-100, kept for the next play. Prints
# the level.
volume() {
  local arg="${1:-}" level
  level=$(saved_volume)
  if running; then
    level=$(ipc '{"command":["get_property","volume"]}' | jq -r '.data // 100 | round')
  fi
  if [[ -n $arg ]]; then
    [[ $arg =~ ^[+-]?[0-9]+$ ]] || fail "volume needs a level from 0 to 100, or +N / -N"
    case "$arg" in
      [+-]*) level=$((level + arg)) ;;
      *) level=$((10#$arg)) ;;
    esac
    ((level < 0)) && level=0
    ((level > 100)) && level=100
    echo "$level" >"$VOLUME"
    if running; then
      ipc "{\"command\":[\"set_property\",\"volume\",$level]}" >/dev/null
    fi
  fi
  echo "$level"
}

# sleep_timer [minutes|off] — stop playback after a while; prints the timer
# as JSON. The waiter only acts while its token is the one on file, so
# setting a new timer or cancelling retires the old waiter within seconds.
sleep_timer() {
  local minutes="${1:-}" token until
  if [[ -n $minutes ]]; then
    rm -f "$SLEEP"
    if [[ $minutes != off && $minutes != 0 ]]; then
      [[ $minutes =~ ^[0-9]+$ ]] || fail "sleep needs a number of minutes, or off"
      token="$$.$RANDOM"
      until=$(($(date +%s) + 10#$minutes * 60))
      jq -cn --arg token "$token" --argjson minutes "$((10#$minutes))" --argjson until "$until" \
        '{token:$token, minutes:$minutes, until:$until}' | write_json "$SLEEP"
      (
        while [[ -f $SLEEP && $(<"$SLEEP") == *"\"$token\""* ]]; do
          if (($(date +%s) >= until)); then
            rm -f "$SLEEP"
            if running; then
              stop
              notify "Sleep timer: playback stopped"
            fi
            break
          fi
          sleep 5
        done
      ) >/dev/null 2>&1 &
      disown
    fi
  fi
  cat "$SLEEP" 2>/dev/null || echo '{}'
}

status() {
  if ! running; then
    echo '{"running":false,"paused":false,"title":""}'
    return
  fi
  local paused title
  paused=$(ipc '{"command":["get_property","pause"]}' | jq -r '.data // false')
  title=$(ipc '{"command":["get_property","media-title"]}' | jq -r '.data // ""')
  jq -cn --argjson paused "$paused" --arg title "$title" \
    '{running:true, paused:$paused, title:$title}'
}

# --- sources --------------------------------------------------------------
# Each prints a JSON array of entries, plus a `detail` line for display.

list_soma() {
  fetch "$SOMA_API" | jq -c '
    .channels | sort_by(-(.listeners | tonumber? // 0))
    | map({source: "SomaFM", name: .title, url: .playlists[0].url, live: true,
           art: (.largeimage // .image // ""), detail: ((.genre | gsub("\\|"; ", ")) + " · " + .description)})'
}

# Radio Browser's country for a query: its code, its name, or a good part of
# its name ("korea"). Prints the two-letter code, or nothing.
radio_country() {
  local file="$CACHE_DIR/countries.json" out
  if [[ ! -s $file ]]; then
    out=$(fetch "$RADIO_API/countries") && [[ -n $out ]] && write_json "$file" <<<"$out"
  fi
  [[ -s $file ]] || return 0
  jq -r --arg q "$1" '
    ($q | ascii_downcase) as $q
    | (map(select((.name | ascii_downcase) == $q or (.iso_3166_1 | ascii_downcase) == $q))
       + (if ($q | length) < 4 then [] else
            map(select(.name | ascii_downcase | contains($q))) | sort_by(-.stationcount) end))
    | first | .iso_3166_1 // empty' "$file"
}

# list_radio [query] — top voted stations without a query. A query matches
# countries, station names and tags, in that order. The API searches one
# field per request, so each is fetched and the results are merged.
list_radio() {
  local query="${1:-}" q code search dir url n=0 urls=()
  if [[ -n $query ]]; then
    q=$(uri "$query")
    code=$(radio_country "$query") || true
    search="$RADIO_API/stations/search?limit=40&hidebroken=true&order=clickcount&reverse=true"
    [[ -n $code ]] && urls+=("$search&countrycode=$code")
    # A bare country code is not worth matching against names and tags.
    [[ -n $code && ${#query} -eq 2 ]] || urls+=("$search&name=$q" "$search&tag=$q")
  else
    urls=("$RADIO_API/stations/topvote/40?hidebroken=true")
  fi
  dir=$(mktemp -d "$RUNTIME_DIR/radio.XXXXXX")
  for url in "${urls[@]}"; do
    fetch "$url" >"$dir/$n.json" &
    n=$((n + 1))
  done
  wait
  jq -cs --arg q "$query" '
    ($q | ascii_downcase) as $q
    | reduce (add | .[]) as $s ({seen: {}, out: []};
        if .seen[$s.stationuuid] then . else .seen[$s.stationuuid] = true | .out += [$s] end)
    | .out[:60]
    | map(select(.url_resolved != "")
      | (.tags | split(",")) as $tags
      | {source: "Radio", name: (.name | gsub("^\\s+|\\s+$"; "")), url: .url_resolved, live: true,
         art: (.favicon // ""), uuid: .stationuuid,
         detail: ([.countrycode, .codec, ((.bitrate|tostring) + "k"),
                   ($tags | map(select(contains($q))) + map(select(contains($q) | not)) | .[:3] | join(", "))]
                  | map(select(. != "" and . != "0k")) | join(" · "))})' "$dir"/*.json && n=0 || n=$?
  rm -rf "$dir"
  return "$n"
}

# list_audius [query] — trending without a query.
list_audius() {
  local url
  if [[ -n ${1:-} ]]; then
    url="$AUDIUS_API/tracks/search?query=$(uri "$1")&app_name=$APP_NAME&limit=50"
  else
    url="$AUDIUS_API/tracks/trending?app_name=$APP_NAME&limit=50"
  fi
  fetch "$url" | jq -c --arg api "$AUDIUS_API" --arg app "$APP_NAME" '
    .data | map(select(.is_streamable)
      | {source: "Audius", name: (.user.name + " - " + .title), title: .title,
         url: ($api + "/tracks/" + .id + "/stream?app_name=" + $app), live: false,
         art: (.artwork["150x150"] // .artwork["480x480"] // ""),
         detail: (.user.name + " · " + ((.duration / 60 | floor | tostring) + ":"
                  + ((.duration % 60) | tostring | if length < 2 then "0" + . else . end)))})'
}

# Radio Paradise channels. The API lists them; the stream names don't follow
# one pattern, so they are mapped here.
list_paradise() {
  fetch "$PARADISE_API/list_chan?C_user_id=0&ver=2" | jq -c --arg base "$PARADISE_STREAMS" '
    {"0": "aac-320", "1": "mellow-320", "2": "rock-320", "3": "global-320",
     "5": "beyond-320", "42": "serenity", "945": "kfat-320"} as $streams
    | map(select($streams[.chan])
      | {source: "Radio Paradise", name: .title, url: ($base + "/" + $streams[.chan]), live: true,
         art: (.banner_url // ""), chan: .chan,
         detail: ((.current_listeners // "0") + " listening")})'
}

# What a Radio Paradise channel is playing, with cover art.
paradise_now() {
  fetch "$PARADISE_API/now_playing?chan=$(uri "${1:-0}")" | jq -c '{artist, title, album, cover}'
}

# list_ccmixter [query] — editor's picks without a query. f=js, not f=json:
# the json format also copies the whole result into an X-JSON header, which
# overflows curl's header limit past a handful of results.
list_ccmixter() {
  local url
  if [[ -n ${1:-} ]]; then
    url="$CCMIXTER_API?f=js&search=$(uri "$1")&search_type=all&sort=rank&limit=40"
  else
    url="$CCMIXTER_API?f=js&tags=editorial_pick&sort=date&limit=40"
  fi
  fetch "$url" | jq -c '
    map((.user_name | tostring) as $user | (.upload_name | tostring) as $track | . as $u
      | ([.files[] | select(.file_format_info["default-ext"] == "mp3")] | first) as $mp3
      | select($mp3 != null)
      | {source: "ccMixter", name: ($user + " - " + $track), title: $track,
         url: $mp3.download_url, live: false, art: "",
         detail: ([$user, ($mp3.file_format_info.ps // ""), ($u.license_name // "")]
                  | map(select(. != "")) | join(" · "))})'
}

# Source lists are cached for a few minutes so reopening a source is instant;
# when a refresh fails, the last copy is served instead.
cached_list() {
  local kind="$1" query="${2:-}" file out
  file="$CACHE_DIR/$kind.$(printf '%s' "$query" | md5sum | cut -c1-12).json"
  if [[ -s $file ]] && (($(date +%s) - $(stat -c %Y "$file") < CACHE_TTL)); then
    cat "$file"
    return
  fi
  if out=$("list_$kind" "$query") && [[ -n $out ]]; then
    write_json "$file" <<<"$out"
    find "$CACHE_DIR" -name '*.json' -mmin +1440 -delete 2>/dev/null || true
    echo "$out"
  elif [[ -s $file ]]; then
    cat "$file"
  else
    return 1
  fi
}

list() {
  case "${1:-}" in
    soma | paradise | radio | audius | ccmixter) cached_list "$1" "${2:-}" ;;
    favorites) cat "$FAVORITES" ;;
    recent) cat "$RECENT" ;;
    history) cat "$HISTORY" ;;
    *) fail "list: expected soma, paradise, radio, audius, ccmixter, favorites, recent or history" ;;
  esac
}

# --- menus ----------------------------------------------------------------
# The bar card browses in place; these picker menus are for keybindings and
# the terminal.

select_row() {
  omarchy-menu-select "$1" -- --width "${2:-640}"
}

# Shows a list of entries in the picker and prints the chosen index. The
# menu returns "<label>\t<subtext>", which is mapped back to its row.
pick() {
  local prompt="$1" entries="$2" icon="$3" rows choice
  rows=$(jq -r --arg icon "$icon" '.[] | [$icon, .name, (.detail // .source)] | map(gsub("\t"; " ")) | @tsv' <<<"$entries")
  [[ -n $rows ]] || { notify "Nothing found"; return 1; }
  choice=$(select_row "$prompt" <<<"$rows") || return 1
  [[ -n $choice ]] || return 1
  awk -F '\t' -v c="$choice" '($2 "\t" $3) == c { print NR - 1; exit }' <<<"$rows"
}

menu_list() {
  local prompt="$1" entries="$2" icon="$3" queue="${4:-}" index
  index=$(pick "$prompt" "$entries" "$icon") || return 0
  if [[ -n $queue ]]; then
    play_list "$index" "$entries"
  else
    play_entry "$(jq -c ".[$index]" <<<"$entries")"
  fi
}

menu_soma() {
  menu_list "SomaFM" "$(list soma || fail "could not load SomaFM channels")" "$ICON_RADIO"
}

menu_radio() {
  local query
  query=$(omarchy-menu-input "Search radio (name, tag or country)") || return 0
  [[ -n $query ]] || return 0
  menu_list "Radio · $query" "$(list radio "$query" || fail "Radio Browser search failed")" "$ICON_RADIO"
}

menu_paradise() {
  menu_list "Radio Paradise" "$(list paradise || fail "could not load Radio Paradise channels")" "$ICON_RADIO"
}

menu_ccmixter() {
  menu_list "ccMixter · Editor's picks" "$(list ccmixter || fail "could not load ccMixter")" "$ICON_MUSIC" queue
}

menu_audius_trending() {
  menu_list "Audius · Trending" "$(list audius || fail "could not load Audius trending")" "$ICON_MUSIC" queue
}

menu_audius_search() {
  local query
  query=$(omarchy-menu-input "Search Audius tracks") || return 0
  [[ -n $query ]] || return 0
  menu_list "Audius · $query" "$(list audius "$query" || fail "Audius search failed")" "$ICON_MUSIC" queue
}

menu_audius() {
  local choice
  choice=$(printf '%s\t%s\n' "$ICON_TRENDING" "Trending" "$ICON_SEARCH" "Search" | select_row "Audius" 360) || return 0
  case "$choice" in
    "Trending") menu_audius_trending ;;
    "Search") menu_audius_search ;;
  esac
}

menu_favorites() {
  menu_list "Favorites" "$(cat "$FAVORITES")" "$ICON_HEART"
}

menu() {
  local rows choice
  rows=$(
    running && printf '%s\t%s\n' "$ICON_PAUSE" "Play / Pause" "$ICON_STOP" "Stop"
    printf '%s\t%s\n' \
      "$ICON_RADIO" "SomaFM" \
      "$ICON_RADIO" "Radio Paradise" \
      "$ICON_SEARCH" "Radio search" \
      "$ICON_TRENDING" "Audius trending" \
      "$ICON_SEARCH" "Audius search" \
      "$ICON_MUSIC" "ccMixter" \
      "$ICON_HEART" "Favorites"
  )
  choice=$(select_row "shojey" 360 <<<"$rows") || return 0
  case "$choice" in
    "Play / Pause") toggle ;;
    "Stop")
      rm -f "$SLEEP"
      stop
      ;;
    "SomaFM") menu_soma ;;
    "Radio Paradise") menu_paradise ;;
    "Radio search") menu_radio ;;
    "Audius trending") menu_audius_trending ;;
    "Audius search") menu_audius_search ;;
    "ccMixter") menu_ccmixter ;;
    "Favorites") menu_favorites ;;
  esac
}

usage() {
  cat <<USAGE
Usage: shojey <command>

  menu                 open the source picker (default)
  soma | paradise | radio | audius | trending | search | ccmixter | favorites
                       jump straight to one source in the picker
  list soma | paradise | radio [query] | audius [query] | ccmixter [query]
       | favorites | recent | history
                       print entries as JSON
  paradise-now <chan>  current Radio Paradise song and cover as JSON
  play <url> [title]   play a stream or file
  play-json <entry>    play one entry from \`list\`
  play-list <i> <json> queue a \`list\` result and start at index i
  play-saved <url>     replay a recent or favorite entry
  fav [url] [title]    toggle a favorite (default: what's playing)
  forget <url>         remove an entry from recent plays or the song history
  copy <text>          copy a song title to the clipboard
  volume [N|+N|-N]     print or set the player volume, 0-100
  sleep [minutes|off]  stop playback after a while; prints the timer
  resume               play the most recent entry again
  dismiss              clear the last playback error
  toggle               pause / resume (resumes the last entry when stopped)
  stop                 stop playback
  status               print player state as JSON
USAGE
}

case "${1:-menu}" in
  menu) menu ;;
  soma) menu_soma ;;
  paradise) menu_paradise ;;
  ccmixter) menu_ccmixter ;;
  radio) menu_radio ;;
  audius) menu_audius ;;
  trending) menu_audius_trending ;;
  search) menu_audius_search ;;
  favorites) menu_favorites ;;
  list) list "${2:-}" "${3:-}" ;;
  paradise-now) paradise_now "${2:-0}" ;;
  play)
    [[ -n ${2:-} ]] || fail "play needs a url"
    play_entry "$(entry "Stream" "${3:-$2}" "$2" false)"
    ;;
  play-json)
    [[ -n ${2:-} ]] || fail "play-json needs an entry"
    play_entry "$2"
    ;;
  play-list)
    [[ ${2:-} =~ ^[0-9]+$ && -n ${3:-} ]] || fail "play-list needs an index and a JSON list"
    play_list "$2" "$3"
    ;;
  play-saved)
    [[ -n ${2:-} ]] || fail "play-saved needs a url"
    play_saved "$2"
    ;;
  fav) toggle_favorite "${2:-}" "${3:-}" ;;
  toggle) toggle ;;
  resume) resume ;;
  forget) forget "${2:-}" ;;
  copy) copy_text "${2:-}" ;;
  volume) volume "${2:-}" ;;
  sleep) sleep_timer "${2:-}" ;;
  dismiss) rm -f "$ERROR" ;;
  stop)
    rm -f "$SLEEP"
    stop
    ;;
  status) status ;;
  -h | --help | help) usage ;;
  *)
    usage >&2
    exit 1
    ;;
esac
